{
  "expo": {
    "name": "PorsiPas",
    "slug": "porsipas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "porsipas",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.iroastturkey.porsipas",
      "supportsTablet": true
    },
    "android": {
      "package": "com.iroastturkey.porsipas",
      "adaptiveIcon": {
        "backgroundColor": "#EDF7EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PorsiPas to choose a current FoodDrop photo.",
          "cameraPermission": "Allow PorsiPas to photograph surplus food for a FoodDrop.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PorsiPas to calculate FoodDrop distances or set a pickup point while the app is open."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PorsiPas to scan a host's pickup QR for verified collection.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23a66c63-c319-4746-855c-84ff039f55f6"
      }
    },
    "owner": "jesslynsong",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/23a66c63-c319-4746-855c-84ff039f55f6"
    }
  }
}
