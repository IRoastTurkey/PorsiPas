{
  "expo": {
    "name": "PorsiPas",
    "slug": "porsipas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "porsipas",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.iroastturkey.porsipas",
      "supportsTablet": true
    },
    "android": {
      "package": "com.iroastturkey.porsipas",
      "adaptiveIcon": {
        "backgroundColor": "#EDF7EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8F2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PorsiPas to choose a current FoodDrop photo.",
          "cameraPermission": "Allow PorsiPas to photograph surplus food for a FoodDrop.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PorsiPas to set the FoodDrop pickup point while the app is open."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
